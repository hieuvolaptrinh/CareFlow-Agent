# Public Firebase Web App configuration, shared by the local development team.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=

# Optional separate Firebase service-account file. Never commit this file.
# FIREBASE_ADMIN_CREDENTIALS=
# Otherwise the server uses Application Default Credentials (ADC).

# Gemini uses its own project. Do not replace it with FIREBASE_PROJECT_ID.
GCP_PROJECT_ID=
GCP_LOCATION=
GEMINI_MODEL=
# GOOGLE_APPLICATION_CREDENTIALS=

# Explicit opt-in for per-appointment simulation (true for local demo).
CAREFLOW_DEMO_MODE=
# Optional local Firebase Emulator Suite (localhost:9099 and localhost:8080).
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=
# FIREBASE_AUTH_EMULATOR_HOST=
# FIRESTORE_EMULATOR_HOST=
